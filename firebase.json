{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/profile-maker",
        "destination": "/profile-maker.html"
      },
      {
        "source": "/profile-maker/",
        "destination": "/profile-maker.html"
      },
      {
        "source": "/isekai-status",
        "destination": "/isekai-status.html"
      },
      {
        "source": "/isekai-status/",
        "destination": "/isekai-status.html"
      },
      {
        "source": "/shachiku-sugoroku",
        "destination": "/shachiku-sugoroku.html"
      },
      {
        "source": "/shachiku-sugoroku/",
        "destination": "/shachiku-sugoroku.html"
      },
      {
        "source": "/shachiku-shooting",
        "destination": "/shachiku-shooting.html"
      },
      {
        "source": "/shachiku-shooting/",
        "destination": "/shachiku-shooting.html"
      },
      {
        "source": "/station-sign-maker",
        "destination": "/station-sign-maker.html"
      },
      {
        "source": "/station-sign-maker/",
        "destination": "/station-sign-maker.html"
      },
      {
        "source": "/shachiku-jinro",
        "destination": "/shachiku-jinro.html"
      },
      {
        "source": "/shachiku-jinro/",
        "destination": "/shachiku-jinro.html"
      },
      {
        "source": "/excuse-generator",
        "destination": "/excuse-generator.html"
      },
      {
        "source": "/excuse-generator/",
        "destination": "/excuse-generator.html"
      },
      {
        "source": "/barricade-defense",
        "destination": "/barricade-defense.html"
      },
      {
        "source": "/barricade-defense/",
        "destination": "/barricade-defense.html"
      },
      {
        "source": "/shachiku-spiral",
        "destination": "/shachiku-spiral.html"
      },
      {
        "source": "/shachiku-spiral/",
        "destination": "/shachiku-spiral.html"
      },
      {
        "source": "/shachiku-survivor",
        "destination": "/shachiku-survivor.html"
      },
      {
        "source": "/shachiku-survivor/",
        "destination": "/shachiku-survivor.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs24"
    }
  ]
}