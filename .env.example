# OpenCode Go (https://opencode.ai/console) のAPIキーを設定してください
# 開発環境でのみ使用（本番環境ではFirebase Functionsのシークレットで管理）
OPENCODE_GO_API_KEY="YOUR_OPENCODE_GO_API_KEY"

# 任意: 使用するOpenCode GoのモデルID（未指定時は deepseek-v4.1-flash）
# OPENCODE_GO_MODEL="deepseek-v4.1-flash"

# Firebase 設定
# Firebase コンソール (https://console.firebase.google.com/) で取得してください
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcdef"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# 任意: Firebase Functions のベースURL（ステージング環境などで使用）
NEXT_PUBLIC_FUNCTIONS_BASE_URL="https://us-central1-zatsudan-gacha.cloudfunctions.net"
